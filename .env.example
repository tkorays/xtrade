# xtrade — environment variable placeholders.
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit credentials, account IDs, or live endpoints to source control.

# --- General ---
# XTRADE_ENV=development   # one of: development | paper | live
# XTRADE_LOG_LEVEL=INFO

# --- Broker / live trading (placeholders only) ---
# XTRADE_BROKER_ID=replace-me
# XTRADE_BROKER_ACCOUNT=replace-me
# XTRADE_BROKER_PASSWORD=replace-me
# XTRADE_BROKER_API_KEY=replace-me
# XTRADE_BROKER_API_SECRET=replace-me
# XTRADE_BROKER_ENDPOINT=https://example.invalid

# --- Data providers (placeholders only) ---
# XTRADE_DATA_PROVIDER=tushare
# XTRADE_DATA_API_TOKEN=replace-me

# --- Risk limits ---
# XTRADE_RISK_MAX_POSITION_PCT=0.10
# XTRADE_RISK_MAX_DAILY_DRAWDOWN_PCT=0.05
# XTRADE_RISK_MAX_ORDER_NOTIONAL=10000
